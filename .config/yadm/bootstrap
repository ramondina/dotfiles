#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

info() {
    printf '[INFO] %s\n' "$*"
}

error() {
    printf '[ERROR] %s\n' "$*" >&2
}

die() {
    error "$*"
    exit 1
}

case "$(uname -s)" in
    Darwin)
        info "Detected macOS"
        source "$SCRIPT_DIR/bootstrap.d/macos.sh"
        ;;

    Linux)
        source /etc/os-release

        info "Detected Linux: ${PRETTY_NAME:-$ID}"

        case "$ID" in
            debian|ubuntu|linuxmint|pop)
                source "$SCRIPT_DIR/bootstrap.d/linux/debian.sh"
                ;;

            rhel|fedora|centos|rocky|almalinux)
                source "$SCRIPT_DIR/bootstrap.d/linux/redhat.sh"
                ;;

            *)
                die "Unsupported Linux distribution: $ID"
                ;;
        esac

        source "$SCRIPT_DIR/bootstrap.d/linux/common.sh"
        ;;

    *)
        die "Unsupported operating system: $(uname -s)"
        ;;
esac

info "Bootstrap complete."